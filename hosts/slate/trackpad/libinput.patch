+		const double distance = hypot(unaccelerated->x, unaccelerated->y);
+		const double factor = slate_mac_pointer_factor(distance, accel->dpi, seconds);
+		accel->macos_last_motion = time;
+		return (struct normalized_coords) {
+			.x = unaccelerated->x * factor,
+			.y = unaccelerated->y * factor,
+		};
+	}
